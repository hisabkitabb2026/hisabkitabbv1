diff --git a/infrastructure/observability/logstash-patterns.txt b/infrastructure/observability/logstash-patterns.txt
new file mode 100644
index 00000000..8c9f9861
--- /dev/null
+++ b/infrastructure/observability/logstash-patterns.txt
@@ -0,0 +1,65 @@
+###############################################################################
+# Logstash Custom Grok Patterns
+# Patterns for parsing custom application log formats
+###############################################################################
+
+# Laravel/PHP Application Logs
+LARAVEL_TIMESTAMP \[\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\]
+LARAVEL_LOG %{LARAVEL_TIMESTAMP:timestamp} %{DATA:env}\.%{LOGLEVEL:level}: %{GREEDYDATA:message}
+
+# Microservice Request Pattern
+MICROSERVICE_REQUEST \[%{TIMESTAMP_ISO8601:timestamp}\] %{DATA:service} \[%{LOGLEVEL:level}\] %{DATA:method} %{DATA:path} - %{NUMBER:status_code} - %{NUMBER:response_time}ms
+
+# Database Query Pattern
+DB_QUERY \[%{TIMESTAMP_ISO8601:timestamp}\] \[%{DATA:database}\] %{DATA:query_type} on table `%{DATA:table_name}` - %{NUMBER:execution_time}ms
+
+# API Gateway Access Log
+API_GATEWAY_ACCESS %{TIMESTAMP_ISO8601:timestamp} \| %{IPORHOST:client_ip} \| %{DATA:request_method} \| %{DATA:request_path} \| %{NUMBER:status_code} \| %{NUMBER:response_time}ms
+
+# Distributed Trace Pattern
+DISTRIBUTED_TRACE \[%{TIMESTAMP_ISO8601:timestamp}\] trace_id=%{DATA:trace_id} span_id=%{DATA:span_id} parent_span_id=%{DATA:parent_span_id} service=%{DATA:service} operation=%{DATA:operation} duration=%{NUMBER:duration}ms
+
+# Exception Pattern
+EXCEPTION_LOG \[%{TIMESTAMP_ISO8601:timestamp}\] %{LOGLEVEL:level}: %{DATA:exception_type}: %{GREEDYDATA:exception_message}
+
+# Authentication Log
+AUTH_LOG \[%{TIMESTAMP_ISO8601:timestamp}\] %{DATA:auth_type} %{WORD:action} for user %{DATA:username} from %{IPORHOST:source_ip}
+
+# Business Event Pattern
+BUSINESS_EVENT \[%{TIMESTAMP_ISO8601:timestamp}\] %{WORD:event_type} created: %{DATA:entity_type} ID %{NUMBER:entity_id} by user %{NUMBER:user_id}
+
+# Service Health Check
+HEALTH_CHECK \[%{TIMESTAMP_ISO8601:timestamp}\] Health check %{WORD:status}: %{DATA:service} response_time=%{NUMBER:response_time}ms
+
+# Cache Operation
+CACHE_OP \[%{TIMESTAMP_ISO8601:timestamp}\] %{WORD:operation} cache key '%{DATA:cache_key}' - %{NUMBER:operation_time}ms
+
+# Queue Message
+QUEUE_MSG \[%{TIMESTAMP_ISO8601:timestamp}\] Queue %{DATA:queue_name} processed message ID %{DATA:message_id} - %{NUMBER:processing_time}ms
+
+# File Upload
+FILE_UPLOAD \[%{TIMESTAMP_ISO8601:timestamp}\] File upload: %{DATA:filename} \(%{NUMBER:file_size} bytes\) by user %{NUMBER:user_id}
+
+# Report Generation
+REPORT_GEN \[%{TIMESTAMP_ISO8601:timestamp}\] Report %{DATA:report_name} generated: %{DATA:report_type} for company %{NUMBER:company_id} in %{NUMBER:generation_time}ms
+
+# Payment Processing
+PAYMENT_LOG \[%{TIMESTAMP_ISO8601:timestamp}\] Payment %{WORD:status}: %{DATA:transaction_id} amount=%{NUMBER:amount} currency=%{DATA:currency} gateway=%{DATA:gateway}
+
+# Notification Delivery
+NOTIFICATION_LOG \[%{TIMESTAMP_ISO8601:timestamp}\] Notification %{WORD:type} %{WORD:status}: %{DATA:notification_id} to %{DATA:recipient} - %{NUMBER:delivery_time}ms
+
+# Background Job
+BG_JOB_LOG \[%{TIMESTAMP_ISO8601:timestamp}\] Job %{DATA:job_name} %{WORD:status}: %{DATA:job_id} - %{NUMBER:execution_time}ms
+
+# Webhook Event
+WEBHOOK_LOG \[%{TIMESTAMP_ISO8601:timestamp}\] Webhook %{WORD:event_type} to %{DATA:webhook_url} - %{WORD:status} - %{NUMBER:response_time}ms
+
+# Import/Export Operation
+IMPORT_EXPORT_LOG \[%{TIMESTAMP_ISO8601:timestamp}\] %{WORD:operation} %{WORD:status}: %{DATA:file_type} file with %{NUMBER:record_count} records - %{NUMBER:operation_time}ms
+
+# System Performance
+SYSTEM_PERF \[%{TIMESTAMP_ISO8601:timestamp}\] CPU: %{NUMBER:cpu_usage}% \| Memory: %{NUMBER:memory_usage}% \| Disk: %{NUMBER:disk_usage}%
+
+# Service Communication
+SERVICE_COMM \[%{TIMESTAMP_ISO8601:timestamp}\] %{DATA:source_service} -> %{DATA:target_service}: %{DATA:operation} - %{WORD:status} - %{NUMBER:latency}ms
diff --git a/infrastructure/observability/logstash-pipeline.conf b/infrastructure/observability/logstash-pipeline.conf
new file mode 100644
index 00000000..4890d54a
--- /dev/null
+++ b/infrastructure/observability/logstash-pipeline.conf
@@ -0,0 +1,325 @@
+###############################################################################
+# Logstash Pipeline Configuration
+# Log ingestion, processing, and forwarding to Elasticsearch
+###############################################################################
+
+input {
+  ##############################################################################
+  # TCP Input - Receive logs from services
+  ##############################################################################
+  tcp {
+    port => 5000
+    codec => json
+    type => "service_logs"
+    tags => ["tcp_input"]
+  }
+
+  ##############################################################################
+  # UDP Input - Receive logs from services (low-latency)
+  ##############################################################################
+  udp {
+    port => 5000
+    codec => json
+    type => "service_logs"
+    tags => ["udp_input"]
+  }
+
+  ##############################################################################
+  # HTTP Input - Receive logs via HTTP
+  ##############################################################################
+  http {
+    port => 8080
+    codec => json
+    type => "http_logs"
+    tags => ["http_input"]
+  }
+
+  ##############################################################################
+  # Beats Input - Receive logs from Filebeat/Metricbeat
+  ##############################################################################
+  beats {
+    port => 5044
+    type => "beats_input"
+  }
+
+  ##############################################################################
+  # File Input - Tail application log files
+  ##############################################################################
+  file {
+    path => "/var/log/invoiceshelf/**/*.log"
+    start_position => "beginning"
+    codec => multiline {
+      pattern => "^\["
+      negate => true
+      what => "previous"
+    }
+    type => "application_logs"
+    tags => ["file_input"]
+  }
+}
+
+filter {
+  ##############################################################################
+  # JSON Parsing
+  ##############################################################################
+  if [type] in ["service_logs", "http_logs"] {
+    json {
+      source => "message"
+      remove_field => ["message"]
+      skip_on_invalid_json => true
+    }
+  }
+
+  ##############################################################################
+  # Parse Common Application Log Formats
+  ##############################################################################
+  if [type] == "application_logs" {
+    # Parse Laravel/PHP style logs
+    grok {
+      match => { "message" => "\[%{TIMESTAMP_ISO8601:timestamp}\] %{DATA:environment}\.%{LOGLEVEL:level}: %{GREEDYDATA:message}" }
+      keep_on_failure => true
+      add_tag => ["grok_parsed"]
+    }
+
+    # Parse JSON logs
+    if [message] =~ /^\{.*\}$/ {
+      json {
+        source => "message"
+        target => "json_log"
+        skip_on_invalid_json => true
+      }
+      if "_jsonparsefailure" not in [tags] {
+        mutate {
+          replace => { "message" => "%{[json_log][message]}" }
+        }
+      }
+    }
+  }
+
+  ##############################################################################
+  # Service Identification
+  ##############################################################################
+  mutate {
+    add_field => { "[@metadata][source_ip]" => "%{[host][ip]}" }
+  }
+
+  # Identify service from hostname/container name
+  if [docker][container][name] {
+    mutate {
+      add_field => { "service_name" => "%{[docker][container][name]}" }
+    }
+  }
+
+  if [host][hostname] {
+    mutate {
+      add_field => { "service_name" => "%{[host][hostname]}" }
+    }
+  }
+
+  ##############################################################################
+  # Extract Service Domain
+  ##############################################################################
+  if [service_name] =~ /invoice-service/ {
+    mutate {
+      add_field => { "domain" => "invoice" }
+      add_field => { "service" => "invoice-service" }
+    }
+  } else if [service_name] =~ /expense-service/ {
+    mutate {
+      add_field => { "domain" => "expense" }
+      add_field => { "service" => "expense-service" }
+    }
+  } else if [service_name] =~ /product-service/ {
+    mutate {
+      add_field => { "domain" => "product" }
+      add_field => { "service" => "product-service" }
+    }
+  } else if [service_name] =~ /customer-service/ {
+    mutate {
+      add_field => { "domain" => "customer" }
+      add_field => { "service" => "customer-service" }
+    }
+  } else if [service_name] =~ /settings-service/ {
+    mutate {
+      add_field => { "domain" => "settings" }
+      add_field => { "service" => "settings-service" }
+    }
+  } else if [service_name] =~ /transport-service/ {
+    mutate {
+      add_field => { "domain" => "transport" }
+      add_field => { "service" => "transport-service" }
+    }
+  }
+
+  ##############################################################################
+  # Parse HTTP Requests (Kong/API Gateway logs)
+  ##############################################################################
+  if [request_method] {
+    mutate {
+      add_field => { "is_http_request" => true }
+    }
+
+    # Parse HTTP status for severity
+    if [status] >= 500 {
+      mutate {
+        add_field => { "severity" => "error" }
+        add_tag => ["http_error"]
+      }
+    } else if [status] >= 400 {
+      mutate {
+        add_field => { "severity" => "warning" }
+        add_tag => ["http_warning"]
+      }
+    } else {
+      mutate {
+        add_field => { "severity" => "info" }
+      }
+    }
+  }
+
+  ##############################################################################
+  # Parse Database Queries
+  ##############################################################################
+  if [message] =~ /^SELECT|UPDATE|INSERT|DELETE|CREATE|ALTER|DROP/ {
+    mutate {
+      add_field => { "type_of_log" => "database_query" }
+    }
+
+    # Extract table name
+    grok {
+      match => { "message" => "(?<operation>SELECT|UPDATE|INSERT|DELETE|CREATE|ALTER|DROP|TRUNCATE|REPLACE)\s+(?:INTO|FROM|TABLE|INDEX)?\s+`?(?<table>\w+)" }
+      keep_on_failure => true
+    }
+  }
+
+  ##############################################################################
+  # Parse Redis Commands
+  ##############################################################################
+  if [message] =~ /^redis-cli|redis operations/ {
+    mutate {
+      add_field => { "type_of_log" => "redis_command" }
+    }
+  }
+
+  ##############################################################################
+  # Log Level Mapping
+  ##############################################################################
+  if ![level] and [message] =~ /ERROR|CRITICAL|FATAL/ {
+    mutate {
+      add_field => { "level" => "error" }
+    }
+  } else if ![level] and [message] =~ /WARN|WARNING/ {
+    mutate {
+      add_field => { "level" => "warning" }
+    }
+  } else if ![level] and [message] =~ /DEBUG/ {
+    mutate {
+      add_field => { "level" => "debug" }
+    }
+  } else if ![level] {
+    mutate {
+      add_field => { "level" => "info" }
+    }
+  }
+
+  ##############################################################################
+  # Remove Sensitive Data
+  ##############################################################################
+  mutate {
+    # Remove passwords, API keys, tokens
+    gsub => [
+      "message", "password['\"]?\s*[:=]\s*['\"]?[^'\"]*['\"]?", "password=***REDACTED***",
+      "message", "api[_-]key['\"]?\s*[:=]\s*['\"]?[^'\"]*['\"]?", "api_key=***REDACTED***",
+      "message", "token['\"]?\s*[:=]\s*['\"]?[^'\"]*['\"]?", "token=***REDACTED***",
+      "message", "Bearer\s+[^\s]+", "Bearer ***REDACTED***",
+      "message", "credit[_-]card['\"]?\s*[:=]\s*['\"]?[^'\"]*['\"]?", "credit_card=***REDACTED***"
+    ]
+  }
+
+  ##############################################################################
+  # Timestamp Parsing
+  ##############################################################################
+  if ![timestamp] {
+    mutate {
+      add_field => { "timestamp" => "%{@timestamp}" }
+    }
+  }
+
+  date {
+    match => [ "timestamp", "ISO8601", "yyyy-MM-dd'T'HH:mm:ss.SSSZ", "yyyy-MM-dd HH:mm:ss" ]
+    timezone => "UTC"
+    remove_field => [ "timestamp" ]
+  }
+
+  ##############################################################################
+  # Add Metadata
+  ##############################################################################
+  mutate {
+    add_field => {
+      "[@metadata][environment]" => "production"
+      "[@metadata][data_pipeline]" => "logstash"
+      "[@metadata][version]" => "1.0"
+    }
+  }
+}
+
+output {
+  ##############################################################################
+  # Elasticsearch Output - Main storage
+  ##############################################################################
+  elasticsearch {
+    hosts => ["elasticsearch:9200"]
+    index => "logs-%{+YYYY.MM.dd}"
+    document_type => "_doc"
+    template => "/usr/share/logstash/templates/elasticsearch-template.json"
+    template_name => "logs"
+    template_overwrite => true
+    retry_on_conflict => 3
+    user => "elastic"
+    password => "changeme"
+  }
+
+  ##############################################################################
+  # Console Output - Debug/Development
+  ##############################################################################
+  stdout {
+    codec => rubydebug { metadata => true }
+  }
+
+  ##############################################################################
+  # Conditional Outputs
+  ##############################################################################
+  if "error" in [tags] or [level] == "error" {
+    # Route errors to dedicated index
+    elasticsearch {
+      hosts => ["elasticsearch:9200"]
+      index => "logs-errors-%{+YYYY.MM.dd}"
+      document_type => "_doc"
+      user => "elastic"
+      password => "changeme"
+    }
+  }
+
+  # Send critical events to alerting system
+  if [severity] == "critical" or [level] == "error" {
+    http {
+      http_method => "post"
+      url => "http://alertmanager:9093/api/v1/alerts"
+      format => "json"
+      mapping => {
+        "labels" => {
+          "alertname" => "%{[service]}"
+          "severity" => "%{[severity]}"
+          "level" => "%{[level]}"
+          "service" => "%{[service]}"
+          "domain" => "%{[domain]}"
+        }
+        "annotations" => {
+          "summary" => "%{[message]}"
+          "timestamp" => "%{[@timestamp]}"
+        }
+      }
+      keep_alive => false
+    }
+  }
+}
